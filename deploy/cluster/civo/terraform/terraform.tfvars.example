# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# Auth: DON'T put the token here if you can avoid it — prefer the environment:
#   export CIVO_TOKEN="your-civo-api-key"
# (Civo Dashboard → Account → Security → API keys)

region       = "NYC1"
cluster_name = "atlas-civo"

# OPTIONAL — pin the k3s version for a reproducible cluster.
# Left commented, Terraform uses Civo's current default: always valid, so a brand-new user
# never fails on a retired version (just not reproducible across time). To pin:
# 1) List what Civo currently offers:   civo kubernetes versions
#    (or: curl -H "Authorization: bearer $CIVO_TOKEN" https://api.civo.com/v2/kubernetes/versions)
# 2) Uncomment the line below with an EXACT string from that list. Don't reuse the example value —
#    it may already be retired, which makes `terraform apply` fail.
# kubernetes_version = "1.36.0-k3s1"

# The fixed experiment pool (defaults already give 12 vCPU / 48 GB):
# node_size  = "g4p.kube.small"   # 4 vCPU / 16 GB
# node_count = 3
