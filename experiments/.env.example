# Atlas experiments — environment configuration.
#
# This file holds NON-SECRET knobs only. The three credentials (client secret, load-test
# user password, Keycloak admin password) are read live from the cluster — see
# scripts/cluster-credentials.sh and README.md § "Auth for load tests".
#
# Copy to `.env`, adjust, then load it BEFORE the credentials so a stale value here can
# never shadow the live one:
#   set -a; source .env; set +a
#   eval "$(./scripts/cluster-credentials.sh)"
#
# Even so, never commit a filled-in .env.

# ── Edge / API ───────────────────────────────────────────────────────────────
# NGINX ingress in front of atlas-apps. Service APIs live under /api/v1.
ATLAS_GATEWAY=http://<gateway-ip>

# ── Keycloak (OAuth2) ────────────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak.<gateway-ip>.nip.io
KEYCLOAK_REALM=atlas

# Dedicated confidential test client (Direct Access Grants enabled) — never a real client.
# Created by deploy/platform/keycloak/realm-import.yaml; its secret is generated by Keycloak
# and supplied by scripts/cluster-credentials.sh. Do NOT paste it here.
KEYCLOAK_CLIENT_ID=atlas-loadtest
KEYCLOAK_SCOPE=openid

# ── Load-test user pool ──────────────────────────────────────────────────────
# Each k6 VU authenticates as ${LOADTEST_USER_PREFIX}${__VU} so concurrent VUs never share a
# travel-cart (one active cart per user). Provision the pool first with:
#   scripts/seed-loadtest-users.sh   (also reads LOADTEST_USER_PASSWORD + KEYCLOAK_ADMIN_*)
# The pool size caps concurrency: the harness ties MAX_VUS to LOADTEST_USER_COUNT.
LOADTEST_USER_PREFIX=loadtest-
LOADTEST_USER_COUNT=200
# LOADTEST_USER_PASSWORD comes from secret/atlas-realm-credentials via
# scripts/cluster-credentials.sh — not from this file.

# Admin credentials — only used by scripts/seed-loadtest-users.sh, not by k6. Both the user
# and the password default to secret/keycloak-initial-admin, so leave them unset unless you
# deleted temp-admin (Runbook Step 5a) and now use a permanent admin.
# KEYCLOAK_ADMIN_REALM is where the admin authenticates: 'master' for the global superadmin,
# or 'atlas' if your admin is a realm-admin user inside the atlas realm.
KEYCLOAK_ADMIN_REALM=master

# ── Scenario ─────────────────────────────────────────────────────────────────
# What each journey books: flight | hotel | both. One scenario per run; compare runs.
SCENARIO=flight

# ── Bookable-data discovery ──────────────────────────────────────────────────
# The curated route table (origin/destiny/city/departureDate) is HARDCODED in
# lib/k6/config.js (ROUTES) — not here — because you own and validate it. Each route carries
# its own departureDate (also used as the hotel check-in). The knobs below are query params.
SEARCH_ADULTS=1
SEARCH_ROOMS=1
SEARCH_GUESTS=2
SEARCH_NIGHTS=2                    # hotel stay length (check-out = departureDate + nights)
SEARCH_PAGE_SIZE=50

# ── Default load shape (per-experiment overridable with `k6 run -e ...`) ──────
TARGET_RPS=30
RAMP=2m
HOLD=4m
# MAX_VUS defaults to LOADTEST_USER_COUNT and must not exceed it. Leave unset to track the
# pool size; only set it to run below the pool.
# MAX_VUS=200
PRE_ALLOCATED_VUS=20

# ── Experiment 02 — inventory contention (pin every VU onto ONE scarce resource) ─
# Point these at a route/date (or city, for hotels) that exposes exactly ONE in-stock
# resource; capacity C is read live from the inventory API, not set here. Only needed when
# running 02-inventory-contention. See that folder's README.
# CONTENTION_ORIGIN=LIM
# CONTENTION_DESTINY=CUZ
# CONTENTION_DATE=2026-09-01
# CONTENTION_CITY=Cuzco             # for SCENARIO=hotel
# CONTENTION_RESOURCE_ID=           # optional: exact flightId/roomTypeId if several match
# N=100                             # bookings fired at the resource (make it >> capacity/Q)
# Q=1                               # units (seats/rooms) per booking
# SETTLE=45                         # seconds to wait for the Saga before verifying
